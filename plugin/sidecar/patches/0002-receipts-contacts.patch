+function pushUpdate(item) {
+  updatesQueue.push(item);
+  if (updatesQueue.length > MAX_UPDATES_QUEUE_SIZE) {
+    updatesQueue.splice(0, updatesQueue.length - MAX_UPDATES_QUEUE_SIZE);
+  }
